  //   "@prevalentware/opencode-goal-plugin",
  // ],
  "mcp": {
    "github_grep": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.grep.app",
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "mise",
        "exec",
        "--",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--isolated",
      ],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
      },
    },
  },
